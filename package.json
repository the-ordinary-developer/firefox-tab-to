{
  "name": "tab-to",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build && (vite build --watch & web-ext run --source-dir dist)",
    "build": "tsc -b && vite build",
    "package": "npm run build && rm -f tab-to.zip && cd dist && zip -qrX ../tab-to.zip . -x '.*'"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "typescript": "~6.0.2",
    "vite": "^8",
    "web-ext": "^8.10.0"
  }
}
