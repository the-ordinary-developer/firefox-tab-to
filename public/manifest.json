{
  "manifest_version": 3,
  "name": "Tab To",
  "version": "1.1.0",
  "description": "Set new tab URLs for regular and private windows.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": ["storage", "tabs"],
  "background": {
    "page": "background.html"
  },
  "incognito": "spanning",
  "action": {
    "default_title": "Tab To Settings",
    "default_icon": "icon.svg",
    "default_popup": "popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "new-tab.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-to@firefox-tab-to",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
